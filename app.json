{
  "expo": {
    "name": "Smart Service Mobile",
    "slug": "smart-service-mobile",
    "version": "1.0.0",
    "icon": "./src/assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/logo-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f6f8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#f4f6f8"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phep Smart Service truy cap thu vien anh de gui anh OCR cho yeu cau dich vu.",
          "cameraPermission": "Cho phep Smart Service mo camera de chup anh gui kem yeu cau dich vu.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
